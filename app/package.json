    "@azure/search-documents": "^12.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@google/genai": "^1.44.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/community": "^1.1.22",
    "@langchain/core": "^1.1.31",
    "@mistralai/mistralai": "^1.15.1",
    "@qdrant/js-client-rest": "^1.17.0",
    "@supabase/supabase-js": "^2.99.0",
    "@types/multer": "^2.0.0",
    "@types/ws": "^8.18.1",
    "better-auth": "^1.2.0",
    "better-sqlite3": "^12.6.2",
    "bullmq": "^5.30.0",
    "cloudflare": "^5.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "groq-sdk": "^0.37.0",
    "ioredis": "^5.4.0",
    "mem0ai": "^2.3.0",
    "multer": "^2.0.2",
    "neo4j-driver": "^6.0.1",
    "ollama": "^0.6.3",
    "pg": "^8.18.0",
    "redis": "^5.11.0",
    "uuid": "^11.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.0",

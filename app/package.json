    "autoprefixer": "^10.4.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.6",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.0",
